{
  "expo": {
    "name": "Drift",
    "slug": "Drift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.github.esamjr.drift",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Drift needs microphone access to record a voice moment.",
        "NSCameraUsageDescription": "Drift needs camera access so you can take photos for your moments.",
        "NSPhotoLibraryUsageDescription": "Drift needs access to your photos to add them to a moment.",
        "NSFaceIDUsageDescription": "Allow Drift to use Face ID for fast and private unlocking."
      }
    },
    "android": {
      "package": "io.github.esamjr.drift",
      "adaptiveIcon": {
        "backgroundColor": "#13121B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#13121B",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      "expo-font",
      "expo-asset",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47b9076f-505b-47b6-83e4-51c6b5f4966f"
      }
    },
    "owner": "esamjr"
  }
}
