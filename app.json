{
  "expo": {
    "name": "Drift",
    "slug": "Drift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.drift.journal",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Drift needs microphone access to record a voice moment.",
        "NSCameraUsageDescription": "Drift needs camera access so you can take photos for your moments.",
        "NSPhotoLibraryUsageDescription": "Drift needs access to your photos to add them to a moment.",
        "NSFaceIDUsageDescription": "Allow Drift to use Face ID for fast and private unlocking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#13121B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#13121B",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
